# =============================================================================
# Vanta Server — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# =============================================================================

# ── LLM (OpenRouter) ─────────────────────────────────────────────────────────
# OpenRouter key. Starts with sk-or-v1-
# The server auto-detects OpenRouter keys and routes to openrouter.ai/api/v1.
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here

# ── Supabase (add in Phase 1) ─────────────────────────────────────────────────
# Project URL — found in Supabase dashboard → Settings → API → Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key — found in Supabase dashboard → Settings → API → service_role
# WARNING: This key bypasses all RLS policies. NEVER expose it to the browser
# or commit it to git. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ── Local Embedding Model (add in Phase 2) ────────────────────────────────────
# Directory where @huggingface/transformers caches model weights.
# Model: BAAI/bge-small-en-v1.5 (~130 MB, downloaded once on first startup).
# Do not install or initialise the embedding model during Phase 0.
TRANSFORMERS_CACHE=./data/models

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Legacy SQLite (Phase 0 only — removed after migration) ───────────────────
# Remove this variable once the application is fully migrated to Supabase.
DB_PATH=./data/vanta.db
