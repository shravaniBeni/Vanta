# ─── Vanta Server — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Supabase (server-side — service role key, NEVER expose in browser) ────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── LLM (OpenRouter or OpenAI) ────────────────────────────────────────────────
# OpenRouter keys start with sk-or-v1-
OPENAI_API_KEY=sk-or-v1-your-key-here

# ── Embeddings — local ONNX (production default) ─────────────────────────────
# Xenova/bge-small-en-v1.5 runs in-process via @huggingface/transformers.
# Downloads ~45 MB of ONNX weights on first boot, then caches to disk.
# Requires a persistent process with >=512 MB RAM.
# Set this to a writable directory so the model survives restarts.
TRANSFORMERS_CACHE=./data/model-cache

# ── Embeddings — HuggingFace Inference API (optional fallback) ────────────────
# Set USE_HF_API=true ONLY on hosts where the local model cannot run
# (e.g. Render free tier, serverless, <512 MB RAM).
# The HF API uses the same model and vector dimension — no DB migration needed.
# USE_HF_API=true
# HF_API_TOKEN=hf_your_token_here   # free at huggingface.co/settings/tokens

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production: set to your deployed frontend URL.
# Example: https://vanta.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
