# ─── Vanta Server — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Supabase (server-side — service role key, NEVER expose in browser) ────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── LLM (OpenRouter or OpenAI) ────────────────────────────────────────────────
# OpenRouter keys start with sk-or-v1-
OPENAI_API_KEY=sk-or-v1-your-key-here

# ── Embeddings ────────────────────────────────────────────────────────────────
# Default (free, no cold start penalty): HuggingFace Inference API
# Get a free token at https://huggingface.co/settings/tokens
# Without a token the API still works but has lower rate limits.
HF_API_TOKEN=hf_your_token_here

# Optional: set to true to run embeddings locally instead (requires persistent process)
# USE_LOCAL_EMBEDDINGS=true
# TRANSFORMERS_CACHE=./data/model-cache

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production: set to your Vercel/Render frontend URL.
# Example: https://vanta.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
