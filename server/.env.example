# =============================================================================
# Vanta Server — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# =============================================================================

# ── LLM (OpenRouter) ─────────────────────────────────────────────────────────
# OpenRouter key. Starts with sk-or-v1-
# The server auto-detects OpenRouter keys and routes to openrouter.ai/api/v1.
OPENAI_API_KEY=sk-or-v1-your-openrouter-key-here

# ── Supabase (required from Phase 1 onwards) ──────────────────────────────────
# Project URL — Supabase dashboard → Settings → API → Project URL
# Use the base URL only: https://<ref>.supabase.co
# Do NOT append /rest/v1/ or any path suffix.
SUPABASE_URL=https://<project-ref>.supabase.co

# Service role key — Supabase dashboard → Settings → API → service_role key
# WARNING: This key bypasses all RLS policies.
# NEVER expose it to the browser. NEVER commit it to git. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ── Local Embedding Model (add in Phase 2) ────────────────────────────────────
# Directory where @huggingface/transformers caches BAAI/bge-small-en-v1.5.
# Model is ~130 MB, downloaded once on first startup after Phase 2.
# Do not install or initialise the embedding model until Phase 2.
TRANSFORMERS_CACHE=./data/models

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
