# ─── Vanta Server — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Supabase (server-side — service role key, NEVER expose in browser) ────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── LLM (OpenRouter or OpenAI) ────────────────────────────────────────────────
# OpenRouter keys start with sk-or-v1-
# Standard OpenAI keys start with sk-
OPENAI_API_KEY=sk-or-v1-your-key-here

# ── Embeddings model cache ────────────────────────────────────────────────────
# Directory where Xenova/bge-small-en-v1.5 ONNX weights are cached (~45 MB).
# On Railway/Render: set to a path inside the persistent volume if available,
# otherwise the model re-downloads on every cold start (~10s on first request).
# Leave unset to use the default HuggingFace cache (~/.cache/huggingface).
TRANSFORMERS_CACHE=./data/model-cache

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In production: set to your Vercel deployment URL.
# Example: https://vanta.vercel.app,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
