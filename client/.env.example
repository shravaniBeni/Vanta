# ─── Vanta Client — Environment Variables ────────────────────────────────────
# Copy this file to .env (for local dev) or set in Vercel dashboard (for production).
# All VITE_* variables are embedded into the browser bundle at build time.
# Never put secrets here — these values are visible in the browser.

# ── Supabase (browser-safe anon key only) ─────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend API URL ───────────────────────────────────────────────────────────
# Local dev: leave empty (Vite proxy forwards /api to localhost:3001)
# Production: set to your Railway/Render/Fly deployment URL
# Example: https://vanta-server.up.railway.app
VITE_API_URL=
