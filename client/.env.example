# =============================================================================
# Vanta Client — Environment Variables
# Copy this file to .env and fill in real values.
# All VITE_* variables are bundled into the browser build — safe to expose.
# =============================================================================

# ── Supabase (add in Phase 6) ─────────────────────────────────────────────────
# Project URL — same value as server SUPABASE_URL (base URL, no path suffix)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key — Supabase dashboard → Settings → API → anon (public) key
# Safe to expose in the browser. RLS policies control access.
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ── API URL ───────────────────────────────────────────────────────────────────
# Leave empty in development — Vite proxy forwards /api to localhost:3001.
# Set to the deployed backend URL in production.
VITE_API_URL=
